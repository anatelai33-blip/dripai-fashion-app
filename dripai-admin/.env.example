# ============================================
# DRIPAI ADMIN PANEL - Environment Configuration
# ============================================

# Server Configuration
NODE_ENV=development
PORT=3000
SESSION_SECRET=your_secure_session_secret_here
JWT_SECRET=your_jwt_secret_here

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dripai_admin
DB_USER=postgres
DB_PASSWORD=your_db_password

# Admin Credentials (Change these after first login!)
ADMIN_EMAIL=admin@dripai.store
ADMIN_PASSWORD=your_secure_admin_password

# Cloudflare API Configuration
# Get your API token from: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Zone:Read, DNS:Edit, Zone Settings:Edit, Cache Purge:Edit
CLOUDFLARE_ZONE_ID=your_zone_id_here
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here

# Domain Configuration
DOMAIN=dripai.store
WWW_DOMAIN=www.dripai.store

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# Rate Limiting (milliseconds)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=12
